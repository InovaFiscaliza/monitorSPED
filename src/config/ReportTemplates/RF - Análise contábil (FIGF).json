    {
        "Type": "ItemN1",
        "Recurrence": 0,
        "Data": {
            "Editable": "false",
            "Text": "CONCLUSÃO",
            "Variable": [],
            "Component": [
                {
                    "Type": "ItemN2",
                    "Data": {
                        "Editable": "true",
                        "Text": "Com base nas informações da Prestadora NOVA TELECOM LTDA - EPP, CNPJ nº 08.778.322/0001-78, os valores de contribuições devidas ao Fust em relação às receitas de telecomunicações auferidas no exercício financeiro de 2023 totalizam R$ 164.915,13 (sento e sessenta e quatro mil novecentos e quinze reais e treze centavos).",
                        "Variable": []
                    }
                },
                {
                    "Type": "ItemN2",
